# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Files that must keep CRLF for Windows tooling.
*.sln        text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf
*.manifest   text eol=crlf

# Binary assets.
*.ico  binary
*.png  binary
*.jpg  binary
*.exe  binary
