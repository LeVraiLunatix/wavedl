<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ========================= DARK (défaut) ========================= -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WaveBgBrush" Color="#08090D" />
            <SolidColorBrush x:Key="WaveSurfaceBrush" Color="#14161D" />
            <SolidColorBrush x:Key="WaveSurfaceAltBrush" Color="#1C1F29" />
            <SolidColorBrush x:Key="WaveElevatedBrush" Color="#22262F" />
            <SolidColorBrush x:Key="WaveStrokeBrush" Color="#2A2F3B" />
            <SolidColorBrush x:Key="WaveHairlineBrush" Color="#1E222B" />
            <SolidColorBrush x:Key="WaveTextBrush" Color="#F1F3F7" />
            <SolidColorBrush x:Key="WaveTextSecondaryBrush" Color="#9AA1AF" />
            <SolidColorBrush x:Key="WaveFaintBrush" Color="#626A79" />
            <SolidColorBrush x:Key="WaveAccentBrush" Color="#3D8BFF" />
            <SolidColorBrush x:Key="WaveAccentHoverBrush" Color="#63A4FF" />
            <SolidColorBrush x:Key="WaveAccentPressedBrush" Color="#255FD6" />
            <SolidColorBrush x:Key="WaveDangerBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="WaveSuccessBrush" Color="#43D183" />

            <LinearGradientBrush x:Key="WaveHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#1B2C4E" />
                <GradientStop Offset="0.5" Color="#141824" />
                <GradientStop Offset="1.0" Color="#0E0F16" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#191C25" />
                <GradientStop Offset="1.0" Color="#131620" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveAccentFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#4E97FF" />
                <GradientStop Offset="1.0" Color="#2C74EB" />
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="WaveGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Offset="0.0" Color="#553D8BFF" />
                <GradientStop Offset="1.0" Color="#003D8BFF" />
            </RadialGradientBrush>
        </ResourceDictionary>

        <!-- ========================= LIGHT ========================= -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WaveBgBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="WaveSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WaveSurfaceAltBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="WaveElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WaveStrokeBrush" Color="#DFE3EB" />
            <SolidColorBrush x:Key="WaveHairlineBrush" Color="#E9ECF2" />
            <SolidColorBrush x:Key="WaveTextBrush" Color="#13151B" />
            <SolidColorBrush x:Key="WaveTextSecondaryBrush" Color="#59616F" />
            <SolidColorBrush x:Key="WaveFaintBrush" Color="#8A909D" />
            <SolidColorBrush x:Key="WaveAccentBrush" Color="#1F6FEB" />
            <SolidColorBrush x:Key="WaveAccentHoverBrush" Color="#1A5FCC" />
            <SolidColorBrush x:Key="WaveAccentPressedBrush" Color="#154DA6" />
            <SolidColorBrush x:Key="WaveDangerBrush" Color="#D93A3A" />
            <SolidColorBrush x:Key="WaveSuccessBrush" Color="#1E9E56" />

            <LinearGradientBrush x:Key="WaveHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#DCE8FF" />
                <GradientStop Offset="0.6" Color="#EEF2F8" />
                <GradientStop Offset="1.0" Color="#F3F5F8" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#FFFFFF" />
                <GradientStop Offset="1.0" Color="#FAFBFD" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaveAccentFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#3A85F0" />
                <GradientStop Offset="1.0" Color="#1F6FEB" />
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="WaveGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Offset="0.0" Color="#301F6FEB" />
                <GradientStop Offset="1.0" Color="#001F6FEB" />
            </RadialGradientBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ========================= Scalars ========================= -->
    <CornerRadius x:Key="WaveCardCorner">16</CornerRadius>
    <CornerRadius x:Key="WaveInnerCorner">11</CornerRadius>
    <CornerRadius x:Key="WavePillCorner">999</CornerRadius>
    <Thickness x:Key="WavePagePadding">36,26,36,40</Thickness>
    <x:Double x:Key="WaveContentMaxWidth">1120</x:Double>

    <!-- ========================= Text styles ========================= -->
    <Style x:Key="WaveDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="Foreground" Value="{ThemeResource WaveTextBrush}" />
    </Style>

    <Style x:Key="WavePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WaveTextBrush}" />
    </Style>

    <Style x:Key="WaveSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WaveTextBrush}" />
        <Setter Property="Margin" Value="0,4,0,10" />
    </Style>

    <Style x:Key="WaveCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource WaveTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ========================= Surfaces ========================= -->
    <Style x:Key="WaveCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WaveCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WaveStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource WaveCardCorner}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ========================= Buttons ========================= -->
    <Style x:Key="WaveAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource WaveAccentFillBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
