<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WaveDL.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WaveDL.Helpers.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToImageSourceConverter x:Key="ImageConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
            <conv:BytesToStringConverter x:Key="BytesToString" />
            <conv:PercentToStringConverter x:Key="PercentToString" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
