<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WaveDL.Views.LinkImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WaveDL.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <ScrollViewer Padding="{StaticResource WavePagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="920">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="22" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Depuis un lien" Style="{StaticResource WavePageTitleStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource WaveTextSecondaryBrush}"
                       Text="YouTube, YouTube Music, playlist, album — ou un lien Spotify / Deezer / Apple Music pour retrouver la version sur YouTube Music. Vous pouvez aussi déposer un lien sur cette page." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" MinHeight="46" FontSize="15" PlaceholderText="https://…"
                         Text="{Binding LinkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Coller" Command="{Binding PasteCommand}" />
                <Button Grid.Column="2" Style="{StaticResource WaveAccentButtonStyle}" Content="Analyser"
                        Command="{Binding ResolveCommand}" />
            </Grid>

            <ProgressRing IsActive="{Binding IsBusy}" Width="26" Height="26" HorizontalAlignment="Center" />
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding ErrorMessage}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource WaveCaptionStyle}"
                       Visibility="{Binding StatusText, Converter={StaticResource HasValueToVisibility}}" />

            <!-- Identified track from Spotify / Deezer / Apple Music -->
            <Border Style="{StaticResource WaveCardStyle}"
                    Visibility="{Binding ShowExternalInfo, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="10" Background="{ThemeResource WaveSurfaceAltBrush}">
                        <Image Source="{Binding ResolvedInfo.CoverUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ResolvedInfo.SourceLabel}" Style="{StaticResource WaveCaptionStyle}" />
                        <TextBlock Text="{Binding ResolvedInfo.Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResolvedInfo.Artist}" Foreground="{ThemeResource WaveTextSecondaryBrush}" />
                        <TextBlock Text="{Binding ResolvedInfo.Album}" Style="{StaticResource WaveCaptionStyle}"
                                   Visibility="{Binding ResolvedInfo.Album, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- YouTube Music candidates -->
            <StackPanel Spacing="12" Visibility="{Binding ShowCandidates, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Correspondances YouTube Music" Style="{StaticResource WaveSectionHeaderStyle}" />
                <ListView ItemsSource="{Binding Candidates}" SelectionMode="Single"
                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MatchCandidate">
                            <Grid ColumnSpacing="14" Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8" Background="{ThemeResource WaveSurfaceAltBrush}">
                                    <Image Source="{Binding Track.BestThumbnailUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Track.Artist}" Style="{StaticResource WaveCaptionStyle}" />
                                    <TextBlock Text="{Binding Track.DurationText}" Style="{StaticResource WaveCaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource WaveCaptionStyle}" HorizontalAlignment="Right" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ConfidencePercent}" />
                                    <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource WaveCaptionStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox MinWidth="200" Header="Format" ItemsSource="{Binding Formats}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                    <Button Style="{StaticResource WaveAccentButtonStyle}" VerticalAlignment="Bottom"
                            Content="Télécharger la sélection" Command="{Binding DownloadSelectedCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Playlist / album -->
            <Border Style="{StaticResource WaveCardStyle}"
                    Visibility="{Binding ShowPlaylist, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Playlist.Title}" Style="{StaticResource WaveSectionHeaderStyle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox MinWidth="200" Header="Format" ItemsSource="{Binding Formats}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                        <Button Style="{StaticResource WaveAccentButtonStyle}" VerticalAlignment="Bottom"
                                Content="Tout télécharger" Command="{Binding DownloadPlaylistCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PlaylistTracks}" MaxHeight="360">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WaveCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource WaveCaptionStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
