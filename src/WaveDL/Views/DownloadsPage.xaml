<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WaveDL.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WaveDL.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource WavePagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Téléchargements" Style="{StaticResource WavePageTitleStyle}" />
            <Button Grid.Column="1" VerticalAlignment="Center" Content="Nettoyer la liste"
                    Command="{Binding ClearFinishedCommand}"
                    Visibility="{Binding HasFinishedItems, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE896;" FontSize="34" Foreground="{ThemeResource WaveTextSecondaryBrush}" />
            <TextBlock Text="Aucun téléchargement en cours." Foreground="{ThemeResource WaveTextSecondaryBrush}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                    <Border Style="{StaticResource WaveCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                    Background="{ThemeResource WaveSurfaceAltBrush}">
                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource WaveCaptionStyle}"
                                           Visibility="{Binding Artist, Converter={StaticResource HasValueToVisibility}}" />

                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding IsIndeterminate}"
                                             Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVisibility}}" />

                                <Grid ColumnSpacing="16"
                                      Visibility="{Binding ShowMetrics, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PercentText}" Style="{StaticResource WaveCaptionStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource WaveCaptionStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding EtaText}" Style="{StaticResource WaveCaptionStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource WaveCaptionStyle}" HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource WaveCaptionStyle}" />
                                    <TextBlock Text="{Binding FormatText}" Style="{StaticResource WaveCaptionStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Width="40" Height="40" Padding="0" Command="{Binding PauseResumeCommand}"
                                        ToolTipService.ToolTip="{Binding PauseResumeLabel}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE768;" FontSize="14"
                                                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                        <FontIcon Glyph="&#xE769;" FontSize="14"
                                                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                                <Button Width="40" Height="40" Padding="0" Command="{Binding CancelCommand}"
                                        ToolTipService.ToolTip="Annuler"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button Width="40" Height="40" Padding="0" Command="{Binding OpenFolderCommand}"
                                        ToolTipService.ToolTip="Ouvrir le dossier"
                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
