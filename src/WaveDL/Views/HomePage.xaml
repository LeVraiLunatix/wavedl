<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WaveDL.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WaveDL.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource WavePagePadding}">
        <StackPanel Spacing="26" MaxWidth="960" HorizontalAlignment="Stretch">

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Border CornerRadius="18" Padding="30" Background="{ThemeResource WaveHeroBrush}"
                    BorderBrush="{ThemeResource WaveStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock Text="Bibliothèque musicale" Style="{StaticResource WavePageTitleStyle}" />
                    <TextBlock Foreground="{ThemeResource WaveTextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Colle un lien YouTube, YouTube Music, Spotify, Deezer ou Apple Music, ou recherche directement un morceau." />

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        MinHeight="52"
                        FontSize="17"
                        PlaceholderText="Colle un lien ou recherche un morceau"
                        QueryIcon="Find"
                        TextMemberPath="Title"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding Suggestions}"
                        QuerySubmitted="OnQuerySubmitted"
                        SuggestionChosen="OnSuggestionChosen">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid ColumnSpacing="12" Padding="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{ThemeResource WaveSurfaceAltBrush}">
                                        <Image Source="{Binding BestThumbnailUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WaveCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center"
                                               Style="{StaticResource WaveCaptionStyle}" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="18" CornerRadius="12" Command="{Binding GoToLinkCommand}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE71B;" HorizontalAlignment="Left" Foreground="{ThemeResource WaveAccentBrush}" />
                        <TextBlock Text="Télécharger depuis un lien" FontWeight="SemiBold" />
                        <TextBlock Text="YouTube, playlist, Spotify…" Style="{StaticResource WaveCaptionStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="18" CornerRadius="12" Command="{Binding GoToSearchCommand}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE721;" HorizontalAlignment="Left" Foreground="{ThemeResource WaveAccentBrush}" />
                        <TextBlock Text="Rechercher un morceau" FontWeight="SemiBold" />
                        <TextBlock Text="Recherche façon Apple Music" Style="{StaticResource WaveCaptionStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="18" CornerRadius="12" Command="{Binding GoToHistoryCommand}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE81C;" HorizontalAlignment="Left" Foreground="{ThemeResource WaveAccentBrush}" />
                        <TextBlock Text="Historique" FontWeight="SemiBold" />
                        <TextBlock Text="Vos téléchargements" Style="{StaticResource WaveCaptionStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Spacing="4" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Derniers téléchargements" Style="{StaticResource WaveSectionHeaderStyle}" />
                <Border Style="{StaticResource WaveCardStyle}" Padding="6">
                    <ListView
                        ItemsSource="{Binding RecentDownloads}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnRecentClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEntry">
                                <Grid ColumnSpacing="14" Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{ThemeResource WaveSurfaceAltBrush}">
                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WaveCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding QualityText}" VerticalAlignment="Center"
                                               Style="{StaticResource WaveCaptionStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
