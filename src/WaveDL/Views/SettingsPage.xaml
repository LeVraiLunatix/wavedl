<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WaveDL.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource WavePagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="760">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="22" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="Paramètres" Style="{StaticResource WavePageTitleStyle}" />

            <Border Style="{StaticResource WaveCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Téléchargement" Style="{StaticResource WaveSectionHeaderStyle}" Margin="0" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Dossier de destination" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding DownloadDirectory}" />
                            <Button Grid.Column="1" Content="Modifier" Command="{Binding ChangeFolderCommand}" />
                            <Button Grid.Column="2" Content="Ouvrir" Command="{Binding OpenDownloadFolderCommand}" />
                        </Grid>
                    </StackPanel>

                    <ComboBox Header="Format par défaut" MinWidth="240" ItemsSource="{Binding Formats}"
                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />

                    <NumberBox Header="Téléchargements simultanés" Minimum="1" Maximum="8" SmallChange="1" LargeChange="1"
                               SpinButtonPlacementMode="Inline" Value="{Binding MaxParallelDownloads, Mode=TwoWay}" />

                    <StackPanel Spacing="4">
                        <NumberBox Header="Limite de vitesse (Ko/s, 0 = illimité)" Minimum="0" Maximum="100000"
                                   SmallChange="64" LargeChange="256" SpinButtonPlacementMode="Inline"
                                   Value="{Binding RateLimitKbps, Mode=TwoWay}" />
                        <TextBlock Text="{Binding RateLimitDisplay}" Style="{StaticResource WaveCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WaveCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application" Style="{StaticResource WaveSectionHeaderStyle}" Margin="0" />
                    <ComboBox Header="Thème" MinWidth="240" ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    <ToggleSwitch Header="Coller automatiquement les liens du presse-papiers"
                                  IsOn="{Binding AutoPasteClipboardLinks, Mode=TwoWay}" />
                    <ToggleSwitch Header="Notifications Windows" IsOn="{Binding ShowNotifications, Mode=TwoWay}" />
                    <ToggleSwitch Header="Vérifier les mises à jour au démarrage"
                                  IsOn="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WaveCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Composants (yt-dlp &amp; FFmpeg)" Style="{StaticResource WaveSectionHeaderStyle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="{Binding ToolsBusy}" Width="18" Height="18" />
                        <TextBlock Text="{Binding ToolStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Installer / réparer" Command="{Binding InstallToolsCommand}" />
                        <Button Content="Mettre à jour yt-dlp" Command="{Binding UpdateYtDlpCommand}" />
                        <Button Content="Journaux" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WaveCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Mises à jour" Style="{StaticResource WaveSectionHeaderStyle}" Margin="0" />
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource WaveCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Vérifier maintenant" Command="{Binding CheckUpdatesCommand}" />
                        <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                                   Style="{StaticResource WaveCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Style="{StaticResource WaveCaptionStyle}"
                       Text="WaveDL ne contourne aucune protection DRM. Ne téléchargez que du contenu dont vous détenez les droits. Les liens Spotify / Deezer / Apple Music servent uniquement à identifier un morceau." />

        </StackPanel>
    </ScrollViewer>
</Page>
