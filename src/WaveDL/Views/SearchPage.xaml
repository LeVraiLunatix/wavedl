<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WaveDL.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WaveDL.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource WavePagePadding}" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recherche" Style="{StaticResource WavePageTitleStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                MinHeight="46"
                FontSize="16"
                PlaceholderText="Ex : Freeze Corleone Shavkat"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnQueryKeyDown" />
            <Button Grid.Column="1" Style="{StaticResource WaveAccentButtonStyle}"
                    Content="Rechercher" Command="{Binding SearchCommand}" />
        </Grid>

        <ProgressRing Grid.Row="2" IsActive="{Binding IsBusy}" Width="34" Height="34"
                      VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" />

        <InfoBar Grid.Row="2" VerticalAlignment="Top" IsOpen="{Binding HasError}" Severity="Error"
                 IsClosable="False" Message="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="2" VerticalAlignment="Top" Spacing="10" Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="{ThemeResource WaveTextSecondaryBrush}" />
            <TextBlock Text="Aucun résultat pour cette recherche." Foreground="{ThemeResource WaveTextSecondaryBrush}" />
        </StackPanel>

        <ListView
            Grid.Row="2"
            ItemsSource="{Binding Results}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnResultClick"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid ColumnSpacing="14" Padding="6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Background="{ThemeResource WaveSurfaceAltBrush}">
                            <Image Source="{Binding BestThumbnailUrl, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource WaveCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource WaveCaptionStyle}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Provider}" Style="{StaticResource WaveCaptionStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
