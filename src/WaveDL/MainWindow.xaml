<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WaveDL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource WaveBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{ThemeResource WaveAccentBrush}" />
                <TextBlock Text="WaveDL" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{ThemeResource WaveTextBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            Background="Transparent"
            ItemInvoked="NavView_ItemInvoked"
            BackRequested="NavView_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Accueil" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recherche" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Depuis un lien" Tag="link">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Téléchargements" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historique" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Paramètres" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8" Margin="32,14,32,0">
                    <InfoBar
                        x:Name="UpdateBar"
                        IsClosable="True"
                        Severity="Informational"
                        IsOpen="{Binding UpdateAvailable}"
                        Message="{Binding UpdateBannerText}">
                        <InfoBar.ActionButton>
                            <Button Content="Voir la version" Command="{Binding OpenReleaseCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        x:Name="ClipboardBar"
                        IsClosable="True"
                        Severity="Success"
                        Title="Lien détecté dans le presse-papiers"
                        IsOpen="{Binding HasClipboardLink}"
                        Message="{Binding ClipboardLink}"
                        CloseButtonClick="ClipboardBar_CloseButtonClick">
                        <InfoBar.ActionButton>
                            <Button Content="Utiliser ce lien" Command="{Binding UseClipboardLinkCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        x:Name="ToolsBar"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Composants requis"
                        IsOpen="{Binding ToolsMissing}"
                        Message="yt-dlp et FFmpeg sont nécessaires pour télécharger. WaveDL peut les installer automatiquement.">
                        <InfoBar.ActionButton>
                            <Button Content="Configurer" Command="{Binding OpenToolSettingsCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
